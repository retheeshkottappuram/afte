APP_NAME=AFTE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afte
DB_USERNAME=afte_user
DB_PASSWORD=your_secure_password

# ─── Session, Cache & Queue ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ─── 24/7 Autonomous Multi-Coin Trading Engine ───────────────────────────────
# TRADING_MODE: paper (simulation) | live (real Binance Futures orders)
TRADING_MODE=live
ALLOW_LIVE_TRADING=true
DAEMON_AUTO_SPAWN=true

# PHP CLI Binary (Use /usr/bin/php on Linux VPS, or leave as php)
PHP_BINARY_PATH=/usr/bin/php

# Capital compounding targets ($5 to $500 challenge)
TRADING_SEED_CAPITAL=5.0
TRADING_TARGET_CAPITAL=500.0

# Top Profitable High-Momentum Monitored Coins (Scanned on 15m & 1h SignalAlgo PRO)
TRADING_MONITORED_COINS="BTCUSDT,ETHUSDT,SOLUSDT,SUIUSDT,NEARUSDT,1000PEPEUSDT,DOGEUSDT,AVAXUSDT,BNBUSDT,XRPUSDT,LINKUSDT,FETUSDT"

# Asset Protection & Risk Parameters
TRADING_MAX_SL_PCT=1.60
TRADING_DEFAULT_SL_PCT=1.25
TRADING_MAX_CONSECUTIVE_LOSSES=3
TRADING_LOSS_COOLDOWN_MINUTES=360

# ─── Binance USDⓈ-M Futures API ──────────────────────────────────────────────
BINANCE_API_KEY=your_binance_futures_api_key
BINANCE_API_SECRET=your_binance_futures_api_secret
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# ─── Telegram Bot Alerts ──────────────────────────────────────────────────────
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_LIVE_ONLY=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── AI Signal Validator ──────────────────────────────────────────────────────
# AI_VALIDATOR_DRIVER: heuristic (fast, built-in) | gemini (Gemini AI API)
AI_VALIDATOR_DRIVER=heuristic
GEMINI_API_KEY=

# ─── Crypto Sentinel Market Watcher ───────────────────────────────────────────
CRYPTO_SYMBOLS="BTCUSDT,ETHUSDT,SOLUSDT,SUIUSDT,NEARUSDT,1000PEPEUSDT,DOGEUSDT,AVAXUSDT,BNBUSDT,XRPUSDT,LINKUSDT,FETUSDT"
CRYPTO_MARKET="futures"
CRYPTO_INTERVAL="15m"
CRYPTO_HTF_INTERVAL="1h"
CRYPTO_MIN_SCORE=75
CRYPTO_COOLDOWN_MINUTES=75
